{
  "Version": 1,
  "Title": "APEXFISSION / EMAIL VERIFICATION",
  "Description": "Isolated email verification test host",
  "Repository": "lambdawalker/go.apexfission.aws.email-verification",
  "Feature": "email-verification",
  "DefaultProject": "test-host",
  "PulumiProject": "email-verification-testhost",
  "PulumiDir": "infrastructure/cmd/testhost",
  "StackPrefix": "test-",
  "BucketPrefix": "testhost-state",
  "BuildPackage": "./cmd/testhost",
  "BuildDir": "dist/testhost",
  "Outputs": ["testHostFunction", "testHostFunctionArn", "testHostTable", "testHostLogs", "senderVerificationRequired", "testHostMobileURL", "testHostMobileUserPoolID", "testHostMobileClientID", "testHostMobileIssuer"],
  "InputsFile": "testhost.json",
  "Functions": {
    "defaultSenderAddress": {
      "Parameters": {"Address": "text", "Domain": "domain"},
      "Result": "email",
      "Template": "{{if contains .Address \"@\"}}{{.Address}}{{else}}{{.Address}}@{{.Domain}}{{end}}"
    }
  },
  "Inputs": [
    {"Name": "Domain", "Label": "Ownership domain", "Help": "Used for AWS resource tags, reports, and the suggested SES From address.", "Kind": "domain", "GitHubVariable": "BENCH_DOMAIN"},
    {
      "Name": "Sender",
      "Label": "SES From address",
      "Help": "Use the suggested address, enter a local part, or enter a full address whose inbox you can access for SES verification.",
      "Kind": "email",
      "GitHubVariable": "BENCH_SENDER",
      "Compose": {
        "Function": "defaultSenderAddress",
        "DefaultInput": "verify",
        "UseLegacyValueAsInput": true,
        "Parameters": {
          "Address": {"Source": "userInput"},
          "Domain": {"Source": "field", "Name": "Domain"}
        }
      }
    },
    {"Name": "Recipient", "Label": "Test recipient", "Help": "Enter the full address that receives the code. In the SES sandbox, verify this address in the deployment region.", "Kind": "email", "GitHubVariable": "BENCH_RECIPIENT"},
    {"Name": "DNSProvider", "Label": "Sender DNS provider", "Help": "Choose the provider serving public DNS for the domain in the From address.", "Kind": "dnsProvider", "GitHubVariable": "BENCH_DNS_PROVIDER"}
  ],
  "ConfigDefaults": {
    "policyJSON": "{}",
    "mobileBaseDomain": "components.email-verification.apexfission.com",
    "mobileDNSProvider": "route53",
    "mobileDNSZone": "apexfission.com"
  },
  "Discovery": {
    "APIURL": "testHostMobileURL",
    "CognitoIssuer": "testHostMobileIssuer",
    "CognitoUserPoolID": "testHostMobileUserPoolID",
    "CognitoClientID": "testHostMobileClientID",
    "ProbeMethod": "POST",
    "ProbePath": "/v1/verification/status",
    "ProbeStatus": 401
  },
  "GitHub": {"Workflow": "testhost-deploy.yml", "EnvironmentPrefix": "testhost-"}
}
